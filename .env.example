# ReaderBee World settings. Copy this file to .env and fill in what you use.
# .env is never committed (see .gitignore) and serve.py never sends it to a browser.

# Talking friends (optional): your Anthropic API key
ANTHROPIC_API_KEY=

# Optional: a faster, cheaper model than the default (claude-opus-5-5)
# READERBEE_MODEL=claude-haiku-4-5-20251001

# Optional: let other devices on this network (an iPad, say) open the game. serve.py otherwise answers only this
# computer. Anyone on the network can then use the talking friends, and so the API key above.
# READERBEE_HOST=0.0.0.0

# School accounts for the teacher pages (optional): your Supabase project's URL and its publishable key
# (Project Settings > API keys). Never put the secret key here. For the database on this computer
# (supabase start), use the API URL and publishable key that `supabase status` prints.
# SUPABASE_URL=https://<your-project>.supabase.co
# SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
